<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <!-- disc pops in -->
    <target android:name="disc">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.6" android:valueTo="1"
                    android:duration="420" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.6" android:valueTo="1"
                    android:duration="420" android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <!-- arrow drops into the tray -->
    <target android:name="arrow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateY" android:valueFrom="-18" android:valueTo="0"
                    android:duration="760"
                    android:interpolator="@android:anim/bounce_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <!-- tray widens -->
    <target android:name="tray">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="scaleX" android:valueFrom="0.3" android:valueTo="0.62"
                android:duration="480"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
